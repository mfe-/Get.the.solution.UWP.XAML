<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <OutputType>Library</OutputType>
    <RootNamespace>Get.the.solution.UWP.XAML</RootNamespace>
    <AssemblyName>Get.the.solution.UWP.XAML</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Platforms>AnyCPU;x86;x64;arm64</Platforms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>Get.the.solution.UWP.XAML</AssemblyTitle>
    <AssemblyDescription>UWP XAML Stuff</AssemblyDescription>
    <AssemblyProduct>Get.the.solution.UWP.XAML</AssemblyProduct>
    <AssemblyCopyright>Copyright ©  2018-2020</AssemblyCopyright>
    <AssemblyVersion>21.01.16.0</AssemblyVersion>
    <FileVersion>21.01.16.0</FileVersion>
    <ComVisible>false</ComVisible>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RepositoryUrl>https://github.com/mfe-/Get.the.solution.UWP.XAML</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Excluded during .NET 10 UWP migration (not used by ResizeImage):
       OpenMenuFlyoutAction -> Microsoft.Xaml.Interactivity (no .NET 10 UWP package yet)
       OnBackRequested      -> Windows.Phone.* (Mobile Extensions SDK removed) -->
  <ItemGroup>
    <Compile Remove="OpenMenuFlyoutAction.cs" />
    <Compile Remove="OnBackRequested.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
  </ItemGroup>

</Project>
