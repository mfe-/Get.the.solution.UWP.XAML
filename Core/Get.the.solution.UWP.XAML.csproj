<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <OutputType>Library</OutputType>
    <RootNamespace>Get.the.solution.UWP.XAML</RootNamespace>
    <AssemblyName>Get.the.solution.UWP.XAML</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Platforms>x86;x64;arm64</Platforms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Excluded during .NET 10 UWP migration (not used by ResizeImage):
       OpenMenuFlyoutAction -> Microsoft.Xaml.Interactivity (no .NET 10 UWP package yet)
       OnBackRequested      -> Windows.Phone.* (Mobile Extensions SDK removed) -->
  <ItemGroup>
    <Compile Remove="OpenMenuFlyoutAction.cs" />
    <Compile Remove="OnBackRequested.cs" />
  </ItemGroup>

</Project>
