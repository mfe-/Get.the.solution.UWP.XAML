<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <RootNamespace>Get.the.solution.UWP.Test.App</RootNamespace>
    <AssemblyName>Get.the.solution.UWP.Test.App</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Platforms>x86;x64;arm64</Platforms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- The App1 sample lives in a sibling subfolder; keep it out of this project's globbing. -->
  <ItemGroup>
    <Compile Remove="App1\**\*.cs" />
    <Page Remove="App1\**\*.xaml" />
    <ApplicationDefinition Remove="App1\**\*.xaml" />
    <Content Remove="App1\**" />
    <None Remove="App1\**" />
    <PRIResource Remove="App1\**" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Get.the.solution.UWP.XAML.csproj" />
  </ItemGroup>

</Project>